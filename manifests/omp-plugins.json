{
  "source": "~/.omp/plugins",
  "enabled": [
    {
      "name": "@giuseppe.trisciuoglio/pi-rules",
      "version": "1.1.1",
      "installSpec": "https://github.com/giuseppe-trisciuoglio/pi-rules",
      "lockSource": "github:giuseppe-trisciuoglio/pi-rules#f99bf49",
      "entrypoints": ["./src/index.ts", "./prompts"]
    },
    {
      "name": "pi-bro",
      "version": "0.9.1",
      "installSpec": "npm:pi-bro@^0.9.1",
      "entrypoints": ["./bro.ts"]
    },
    {
      "name": "pi-commandcode-provider",
      "version": "0.5.1",
      "installSpec": "^0.5.1",
      "entrypoints": ["./index.ts"]
    },
    {
      "name": "pi-patty-bg-tasks",
      "version": "1.1.6",
      "installSpec": "npm:pi-patty-bg-tasks@^1.1.6",
      "entrypoints": ["./index.ts"]
    },
    {
      "name": "pi-rewind",
      "version": "0.5.0",
      "installSpec": "npm:pi-rewind",
      "entrypoints": ["./src/index.ts"]
    },
    {
      "name": "pi-schedule",
      "version": "0.3.6",
      "installSpec": "npm:pi-schedule@^0.3.6",
      "entrypoints": ["./src/extension.ts", "./skills"]
    }
  ],
  "runtimeExcluded": ["node_modules", "cache", "generated native binaries"]
}
